import React from "react";
import ProductCard from "@/components/products/ProductCard";

interface Product {
  id: string;
  name: string;
  description: string;
  price: number;
  currency: string;
  category: string;
  image: string;
  inStock: boolean;
  rating: number;
  reviews: number;
  affiliateUrl?: string | null;
}

async function fetchProducts(): Promise<Product[]> {
  try {
    const res = await fetch("/api/products", {
      cache: "no-store",
      headers: { "Content-Type": "application/json" },
    });
    if (!res.ok) return [];
    const json = await res.json();
    return Array.isArray(json.data) ? (json.data as Product[]) : [];
  } catch {
    return [];
  }
}

export default async function ShopPage() {
  const products = await fetchProducts();

  return (
    <main className="min-h-screen bg-[#05050a] text-white py-8 sm:py-12 px-3 sm:px-6 lg:px-8">
      <div className="max-w-7xl mx-auto">
        <div className="mb-6 sm:mb-10">
          <span className="text-xs font-semibold uppercase tracking-widest text-violet-400 block mb-1.5">
            Catalogue officiel 10-JITAL
          </span>
          <h1 className="text-2xl sm:text-4xl font-extrabold text-white mb-2">
            Boutique & Sélection Affiliation
          </h1>
          <p className="text-gray-400 text-xs sm:text-base">
            Sélection de produits tendances — prix en direct depuis la base.
          </p>
        </div>

        {products.length === 0 ? (
          <div className="bg-[#0b0d17] border border-violet-500/20 rounded-xl p-12 sm:p-16 text-center">
            <p className="text-gray-400">Aucun produit actif pour le moment.</p>
          </div>
        ) : (
          <div className="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-6">
            {products.map((product) => (
              <ProductCard
                key={product.id}
                product={product}
                useCatalogOverride={false}
              />
            ))}
          </div>
        )}
      </div>
    </main>
  );
}