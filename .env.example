# 10-JITAL — Variables d'environnement
# ⚠️ NE JAMAIS committer de valeurs réelles dans ce fichier.
# Copiez ce fichier vers .env.local et remplissez uniquement si nécessaire.

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clé secrète admin (requise pour accéder à /admin)
# Définissez une valeur aléatoire et sécurisée. Aucune valeur par défaut n'est fournie.
ADMIN_SECRET_KEY=

# Clés API d'affiliation (à configurer UNIQUEMENT après vérification manuelle)
# Aucune clé n'est intégrée dans le code source.
AFFILIATION_EXAMPLE_API_KEY=

# Devise par défaut (MAD, EUR, USD)
NEXT_PUBLIC_DEFAULT_CURRENCY=MAD

# Mode démonstration (true = données fictives uniquement)
NEXT_PUBLIC_DEMO_MODE=true

# Planificateur de vérification des prix
# Désactivé par défaut. Activer uniquement après vérification manuelle.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=60